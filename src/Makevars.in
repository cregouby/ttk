USE_PKGCONFIG = @USE_PKGCONFIG@
TTK_LIB_SUBDIR = @TTK_LIB_SUBDIR@

ifeq ($(USE_PKGCONFIG),yes)
  PKG_CPPFLAGS = @PKG_CFLAGS@
  PKG_LIBS = @PKG_LIBS@
else
  TTK_PREFIX = @TTK_PREFIX@
  
  PKG_CPPFLAGS = -I$(TTK_PREFIX)/include \
                 -I$(TTK_PREFIX)/include/ttk/base \
                 -I$(TTK_PREFIX)/include/ttk/vtk
  
  # Allow implicit conversions needed by TTK headers with GCC 13
  PKG_CXXFLAGS = -fpermissive
  
  ifneq ($(TTK_LIB_SUBDIR),)
    TTK_LIB_DIR = $(TTK_PREFIX)/lib/$(TTK_LIB_SUBDIR)
  else
    TTK_LIB_DIR = $(TTK_PREFIX)/lib
  endif
  
  PKG_LIBS = -L$(TTK_LIB_DIR) \
             -lttkCore \
             -lttkTriangulation \
             -lttkScalarFieldCriticalPoints \
             -lttkPersistenceDiagram \
             -lttkContourTree \
             -lttkMergeTree \
             -lttkMorseSmaleComplex
  
  ifneq ($(OS),Windows_NT)
    PKG_LIBS += -Wl,-rpath,$(TTK_LIB_DIR)
  endif
endif