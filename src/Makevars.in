TTK_PREFIX = @TTK_PREFIX@

PKG_CPPFLAGS = -I$(TTK_PREFIX)/include \
               -I$(TTK_PREFIX)/include/ttk/base \
               -I$(TTK_PREFIX)/include/ttk/vtk

PKG_CXXFLAGS = -fpermissive

TTK_LIB_DIR = $(TTK_PREFIX)/lib/@TTK_LIB_SUBDIR@

# Use shell to directly extract library names
TTK_LIB_NAMES := $(shell ls $(TTK_LIB_DIR)/libttk*.so 2>/dev/null | sed 's|.*/lib||;s|\.so$$||')

PKG_LIBS = -L$(TTK_LIB_DIR) $(addprefix -l,$(TTK_LIB_NAMES)) -Wl,-rpath,$(TTK_LIB_DIR)